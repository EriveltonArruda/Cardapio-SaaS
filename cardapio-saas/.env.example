# Configurações do Supabase para Next.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_ID=

# URL pública final do site (sem barra no fim). Usada em SEO: og:url,
# sitemap.xml, metadataBase. Troque para o domínio real antes de ir ao ar.
NEXT_PUBLIC_SITE_URL=https://seusite.com.br

# WhatsApp do DONO do SaaS (você) — com DDI+DDD, só números.
# Recebe aviso de novo lead/cadastro de loja.
NEXT_PUBLIC_SAAS_LEADS_WHATSAPP=5581994530317
# Recebe pedidos de upgrade para o plano Pro.
NEXT_PUBLIC_SAAS_UPGRADE_WHATSAPP=5581979158040

# Links de assinatura recorrente (Mercado Pago). Enquanto vazios, os botões
# de pagamento caem de volta pro WhatsApp manual.
NEXT_PUBLIC_MP_STARTER_LINK=
NEXT_PUBLIC_MP_PRO_LINK=
